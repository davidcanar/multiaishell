<UserControl x:Class="MultiAI.Controls.SessionControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:MultiAI.Controls"
             mc:Ignorable="d"
             d:DesignHeight="400" d:DesignWidth="600"
             MinHeight="200"
             BorderBrush="#555" BorderThickness="1"
             Background="#1e1e1e"
             SnapsToDevicePixels="True"
             UseLayoutRounding="True">

    <Grid Margin="2">
        <Grid.RowDefinitions>
            <!-- Combined header/path/buttons row -->
            <RowDefinition Height="Auto" />
            <!-- Console host row (fills remaining space) -->
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Combined Header / Path / Buttons Row -->
        <Border Grid.Row="0" Background="#2d2d2d" Padding="4" CornerRadius="2">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" MinWidth="80" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Status indicator (gray when stopped, green when running) -->
                <Border x:Name="StatusIndicator"
                        Grid.Column="0"
                        Width="10" Height="10"
                        CornerRadius="5"
                        Background="#666"
                        Margin="0,0,6,0"
                        VerticalAlignment="Center"
                        ToolTip="Stopped" />

                <!-- Session label (read-only: edited via the folder dropdown's Edit option) -->
                <TextBox x:Name="SessionNameBox"
                         Grid.Column="1"
                         Text="Session"
                         IsReadOnly="True"
                         Background="Transparent"
                         Foreground="#ddd"
                         BorderBrush="Transparent"
                         BorderThickness="0"
                         FontSize="13"
                         FontWeight="SemiBold"
                         Padding="4,2"
                         VerticalAlignment="Center"
                         TextWrapping="NoWrap"
                         ToolTip="Session label (edit it via the folder dropdown: right-click → Edit)" />

                <!-- Saved-folder combo (select-only; "Add new entry" opens a dialog) -->
                <ComboBox x:Name="PathBox"
                          Grid.Column="2"
                          FontSize="12"
                          Padding="4,2"
                          Margin="4,0,0,0"
                          VerticalAlignment="Center"
                          VerticalContentAlignment="Center"
                          BorderBrush="#555"
                          ToolTip="Select a saved folder. Right-click to remove saved folders."
                          SelectionChanged="PathBox_SelectionChanged"
                          MouseRightButtonUp="PathBox_RightClick" />

                <!-- Agent selector (select-only; agents are added/edited from the header combo) -->
                <ComboBox x:Name="AgentCombo"
                          Grid.Column="3"
                          Width="105"
                          Height="22"
                          Margin="4,0,4,0"
                          FontSize="12"
                          BorderBrush="#555"
                          ToolTip="Select a coding agent. Add, edit or remove agents from the header combo (right-click)."
                          SelectionChanged="AgentCombo_SelectionChanged" />

                <!-- Launch button -->
                <Button x:Name="LaunchButton"
                        Grid.Column="4"
                        Content="▶"
                        Padding="8,3"
                        Margin="0,0,4,0"
                        FontSize="12"
                        Foreground="#fff"
                        Background="#2d6d2d"
                        BorderBrush="#3a8a3a"
                        BorderThickness="1"
                        ToolTip="Start the selected coding agent in the specified directory"
                        Click="LaunchButton_Click" />

                <!-- Stop button -->
                <Button x:Name="StopButton"
                        Grid.Column="5"
                        Content="■"
                        Padding="8,3"
                        Margin="0,0,4,0"
                        FontSize="12"
                        Foreground="#fff"
                        Background="#8d2d2d"
                        BorderBrush="#aa3a3a"
                        BorderThickness="1"
                        ToolTip="Stop the running session"
                        IsEnabled="False"
                        Click="StopButton_Click" />

                <!-- Open in Explorer button -->
                <Button x:Name="ExplorerButton"
                        Grid.Column="6"
                        Content="📂"
                        Padding="8,3"
                        Margin="0,0,4,0"
                        FontSize="12"
                        Foreground="#ccc"
                        Background="#3d3d3d"
                        BorderBrush="#555"
                        BorderThickness="1"
                        ToolTip="Open the working directory in Windows Explorer"
                        Click="ExplorerButton_Click" />

                <!-- Detach button (pop out embedded console to separate window) -->
                <Button x:Name="TerminalButton"
                        Grid.Column="7"
                        Content="🖥️"
                        Padding="8,3"
                        Margin="0,0,4,0"
                        FontSize="12"
                        Foreground="#ccc"
                        Background="#3d3d3d"
                        BorderBrush="#555"
                        BorderThickness="1"
                        ToolTip="Open a terminal window in the working directory"
                        Click="TerminalButton_Click" />

                <!-- Detach button (pop out embedded console to separate window) -->
                <Button x:Name="DetachButton"
                        Grid.Column="8"
                        Content="🔗"
                        Padding="8,3"
                        Margin="0,0,0,0"
                        FontSize="12"
                        Foreground="#ccc"
                        Background="#3d3d3d"
                        BorderBrush="#555"
                        BorderThickness="1"
                        ToolTip="Pop out the console to a separate window"
                        IsEnabled="False"
                        Click="DetachButton_Click" />

                <!-- Close session button (stops the session and removes it from the grid) -->
                <Button x:Name="CloseSessionButton"
                        Grid.Column="9"
                        Content="✕"
                        Width="24"
                        Padding="4,2"
                        Margin="4,0,0,0"
                        FontSize="12"
                        FontWeight="Bold"
                        Foreground="#fff"
                        Background="#8d2d2d"
                        BorderBrush="#aa3a3a"
                        BorderThickness="1"
                        ToolTip="Close this session (stops it and removes the cell)"
                        Click="CloseSessionButton_Click" />
            </Grid>
        </Border>

        <!-- Console Host (fills remaining space) -->
        <local:ConsoleHost x:Name="ConsoleHostControl"
                           Grid.Row="1"
                           Margin="0,2,0,0"
                           Visibility="Visible" />
    </Grid>

</UserControl>
