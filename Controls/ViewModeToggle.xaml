<UserControl x:Class="MultiAI.Controls.ViewModeToggle"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Width="152" Height="30"
             Focusable="False"
             Cursor="Hand"
             SnapsToDevicePixels="True"
             UseLayoutRounding="True">
    <Border CornerRadius="15" Background="#3d3d3d" BorderBrush="#555" BorderThickness="1" Padding="3">
        <Grid>
            <!-- Sliding thumb: rests over the selected side -->
            <Border x:Name="Thumb"
                    Width="72"
                    HorizontalAlignment="Left"
                    CornerRadius="11"
                    Background="#4ec9b0">
                <Border.RenderTransform>
                    <TranslateTransform x:Name="ThumbTransform" X="0" />
                </Border.RenderTransform>
            </Border>

            <!-- Labels -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="TilesLabel"
                           Grid.Column="0"
                           Text="Tiles"
                           FontSize="12"
                           FontWeight="SemiBold"
                           Foreground="#1e1e1e"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center" />
                <TextBlock x:Name="TabsLabel"
                           Grid.Column="1"
                           Text="Tabs"
                           FontSize="12"
                           FontWeight="SemiBold"
                           Foreground="#999"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center" />
            </Grid>

            <!-- Click targets -->
            <Grid Background="Transparent">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Rectangle Grid.Column="0" Fill="Transparent" MouseLeftButtonDown="TilesSide_Click" />
                <Rectangle Grid.Column="1" Fill="Transparent" MouseLeftButtonDown="TabsSide_Click" />
            </Grid>
        </Grid>
    </Border>
</UserControl>
